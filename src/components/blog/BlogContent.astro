---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../libs/utils";
import Category from "./Category.astro";

interface Props {
  article: CollectionEntry<"blog">;
}

const { article } = Astro.props;

const { data } = article;
---

<section>
  <a href={`/blog/${article.id}`}></a>
  <div class="left">
    <img class="eyecatch" src={data.eyecatch.url} />
  </div>
  <div class="right">
    <div class="description">
      <div class="date">{formatDate(data.publishedAt)}</div>
      <div class="title">{data.title}</div>
      <div class="categories">
        {data.categories.map((category) => <Category data={category} />)}
      </div>
    </div>
  </div>
</section>

<style>
  section {
    position: relative;
    display: flex;

    width: 100%;
  }

  a {
    position: absolute;
    z-index: 999;

    width: 100%;
    height: 100%;
  }

  .left {
    flex: 1;

    overflow: hidden;
  }

  .eyecatch {
    width: 100%;
  }

  .right {
    flex: 2;
  }

  .description {
    display: flex;
    flex-direction: column;

    padding: 12px;
    gap: 8px;
  }

  .date {
    font-size: small;
  }

  .categories {
    display: flex;

    gap: 8px;
  }

  @media (hover: hover) {
    .eyecatch {
      transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    a:hover + div > .eyecatch {
      transform: scale(1.1);
    }
  }
</style>
