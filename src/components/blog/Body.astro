---
interface Props {
  html: string;
}

const { html } = Astro.props;
---

<div id="body" set:html={html} />

<style>
  #body {
    line-height: 2;
    letter-spacing: 0.025em;

    * {
      margin-top: 16px;
    }

    *:first-child {
      margin: 0;
    }

    :where(h1, h2, h3) {
      font-weight: bold;
    }

    h1 {
      margin-top: 64px;
      font-size: larger;
    }

    h2 {
      margin-top: 32px;
      font-size: large;
    }

    a {
      color: var(--color-blue);

      &:hover {
        text-decoration: underline;
      }

      &:visited {
        color: var(--color-iris);
      }
    }

    ul {
      list-style-type: disc;
      padding-left: 24px;
    }

    li {
      margin: 0;
    }

    img {
      width: 100%;
      height: auto;
    }

    pre {
      padding: 16px;

      background-color: var(--color-noir);
      color: var(--color-blanc);

      line-height: 1.25;
      letter-spacing: normal;
    }

    blockquote {
      padding: 16px;

      background-color: var(--color-blanc);
    }
  }
</style>
