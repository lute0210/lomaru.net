---
import { Image } from "astro:assets";
import Heading from "./Heading.astro";

import Icon from "../../assets/icon.jpg";
import { getStatic } from "../../libs/microcms";

const data = await getStatic();
---

<section>
  <Heading>PROFILE</Heading>
  <div class="profile">
    <Image class="icon" src={Icon} alt={"Icon"} />
    <div class="description">
      <div>lute</div>
      <div>{data.affiliation}</div>
      <div>{data.aboutme}</div>
    </div>
  </div>
</section>

<style>
  .profile {
    display: grid;
    grid-template-columns: 1fr 2fr;

    gap: 24px;
  }

  .icon {
    width: 100%;
    height: auto;
    aspect-ratio: 1/1;

    border-radius: 50%;

    animation: shake 3s infinite;
  }

  @keyframes shake {
    0% {
      transform: rotate(3deg);
    }
    50% {
      transform: rotate(-3deg);
    }
    100% {
      transform: rotate(3deg);
    }
  }

  .description {
    display: flex;
    flex-direction: column;
    justify-content: center;

    gap: 8px;

    *:first-child {
      margin-bottom: 8px;
      font-size: x-large;
    }
  }
</style>
