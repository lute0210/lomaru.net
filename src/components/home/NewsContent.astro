---
import { formatDate } from "../../libs/utils";

interface Props {
  date: string;
  title: string;
  link: string;
}

const { date, title, link } = Astro.props;
---

<section>
  <a href={link}></a>
  <div class="body">
    <div class="date">{formatDate(date)}</div>
    <div class="title">{title}</div>
  </div>
</section>

<style>
  section {
    position: relative;
  }

  a {
    position: absolute;

    width: 100%;
    height: 100%;
  }

  .body {
    display: flex;
    align-items: center;

    padding: 16px 12px;
    gap: 16px;
  }

  .date {
    font-size: small;
  }
</style>
