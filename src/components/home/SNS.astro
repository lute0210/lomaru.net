---
import type { SvgComponent } from "astro/types";
import { Image } from "astro:assets";
import Heading from "./Heading.astro";

import Bluesky from "../../assets/bland/bluesky.svg";
import GitHub from "../../assets/bland/github.svg";
import X from "../../assets/bland/x.png";

type Image = ImageMetadata;
type SVG = SvgComponent & ImageMetadata;
type Item = { Target: Image | SVG; href: string };

const list: Item[] = [
  {
    Target: X,
    href: "https://x.com/luteTUT",
  },
  {
    Target: Bluesky,
    href: "https://bsky.app/profile/lomaru.net",
  },
  {
    Target: GitHub,
    href: "https://github.com/lute0x0",
  },
];
---

<section>
  <Heading>SNS</Heading>
  <div class="list">
    {
      list.map(({ Target, href }) => (
        <a href={href} target="_blank">
          {"name" in Target ? <Target /> : <Image src={Target} alt={""} />}
        </a>
      ))
    }
  </div>
</section>

<style>
  section {
    flex: 1;

    display: flex;
    flex-direction: column;
  }

  .list {
    flex: 1;

    display: flex;
    justify-content: center;
    align-items: center;

    gap: 32px;
  }

  :where(svg, img) {
    width: auto;
    height: 32px;
  }

  @media (hover: hover) {
    a {
      transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    a:hover {
      transform: rotate(360deg) scale(1.2);
    }
  }
</style>
