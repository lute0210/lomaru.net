---
import { NewsAPI } from "../../libs/microcms/apis";
import Heading from "./Heading.astro";
import NewsContent from "./NewsContent.astro";

const news = await NewsAPI.get({ orders: "-publishedAt" });
---

<section>
  <Heading>NEWS</Heading>

  <div>
    {
      news.length ? (
        <Fragment>
          {news.map((data) => (
            <Fragment>
              <hr />
              <NewsContent
                date={data.publishedAt}
                title={data.title}
                link={data.link}
              />
            </Fragment>
          ))}
          <hr />
        </Fragment>
      ) : (
        <div>ニュースは無いよ</div>
      )
    }
  </div>
</section>

<style>
  hr {
    margin: 0 4px;

    border: none;
    border-bottom: var(--color-light-noir) 1px dashed;
  }
</style>
