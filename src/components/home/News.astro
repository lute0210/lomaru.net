---
import { getCollection } from "astro:content";
import Heading from "./Heading.astro";
import NewsContent from "./NewsContent.astro";
import type { CollectionEntry } from "astro:content";
import { compareFn_date_str } from "../../libs/utils";

type News = CollectionEntry<"news">;

const news = await getCollection("news");

news
  .sort((a, b) => compareFn_date_str(a.data.publishedAt, b.data.publishedAt))
  .reverse();
---

<section>
  <Heading>NEWS</Heading>

  <div>
    {
      news.length ? (
        <Fragment>
          {news.map(({ data }) => (
            <Fragment>
              <hr />
              <NewsContent
                date={data.publishedAt}
                title={data.title}
                link={data.link}
              />
            </Fragment>
          ))}
          <hr />
        </Fragment>
      ) : (
        <div>ニュースは無いよ</div>
      )
    }
  </div>
</section>

<style>
  hr {
    margin: 0 4px;

    border: none;
    border-bottom: var(--color-light-noir) 1px dashed;
  }
</style>
