---
import Heading from "./Heading.astro";
import NewsComponent from "./NewsComponent.astro";

const news: { date: string; body: string, href: string }[] = [
  { date: "2026.08.08", body: "サイトリニューアル！したよおおおおおおおおおお", href: "" },
  { date: "2026.08.08", body: "サイトリニューアル！", href: "" },
  { date: "2026.08.08", body: "サイトリニューアル！", href: ""},
];
---

<section>
  <Heading>NEWS</Heading>

  <div class="list">
    {news.map(({date, body, href}) => (
      <hr />
      <NewsComponent date={date} body={body} href={href} />
    ))}
    <hr />
  </div>
</section>

<style>
  .list {
    display: flex;
    flex-direction: column;
  }

  hr {
    margin: 0 4px;

    border: none;
    border-bottom: var(--color-light-noir) 1px dashed;
  }
</style>
