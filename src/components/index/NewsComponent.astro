---
interface Props {
  date: string;
  body: string;
  href: string;
}

const { date, body, href } = Astro.props;
---

<section>
  <a href={href}></a>
  <div class="date">{date}</div>
  <div class="body">{body}</div>
</section>

<style>
  section {
    position: relative;
    display: flex;
    align-items: center;

    margin: 0 4px;

    padding: 16px 8px;
    gap: 16px;
  }

  a {
    position: absolute;

    width: 100%;
    height: 100%;
  }

  .date {
    font-size: small;
  }
</style>
