---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Background from "./Background.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  title?: string;
  og_image?: string;
}

const props = Astro.props;

const title = props.title ? `${props.title} - lomaru.net` : "lomaru.net";

const og_image = props.og_image ?? "/assets/eyecatch.png";
const og_url = Astro.url.href;
const twitter_card = "summary";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- ICON -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="lomaru" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- FONT -->
    <Font cssVariable="--font-jk-gothic" />

    <!-- OGP -->
    <meta name="og:url" content={og_url} />
    <meta name="og:title" content={title} />
    <meta name="og:description" content="" />
    <meta name="og:image" content={og_image} />
    <meta name="twitter:card" content={twitter_card} />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <ClientRouter />
  </head>
  <body>
    <Background />

    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --color-blanc: #f7f9fc;
    --color-noir: #333132;
    --color-light-noir: #999899;

    --color-blue: #005392;
    --color-iris: #463689;

    --space: 32px;
  }

  * {
    margin: 0;
    padding: 0;
  }
</style>

<style>
  html {
    height: 100%;
  }

  body {
    display: flex;
    flex-direction: column;

    max-width: 1024px;
    min-height: 100%;

    box-sizing: border-box;

    margin: auto;
    padding: var(--space);
    gap: calc(var(--space) * 2);

    background-color: var(--color-blanc);

    font-family: var(--font-jk-gothic), "Noto Sans JP", sans-serif;
    color: var(--color-noir);
  }

  main {
    flex: 1;

    display: flex;
  }
</style>
