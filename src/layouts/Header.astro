---
import Logo from "../assets/logo.svg";
---

<header>
  <a href="/">
    <Logo class="logo" />
  </a>

  <nav>
    <a class="blog" href="/blog">BLOG</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: var(--space);
  }

  .logo {
    display: block;

    width: auto;
    height: 32px;
  }

  .blog {
    padding: 7px 11px;
    border: var(--color-light-noir) 1px dashed;

    color: initial;
    text-decoration: none;
  }
</style>
