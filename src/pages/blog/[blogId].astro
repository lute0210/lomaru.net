---
import Body from "../../components/blog/Body.astro";
import Category from "../../components/blog/Category.astro";
import Layout from "../../layouts/Layout.astro";
import { BlogAPI } from "../../libs/microcms/apis";
import { formatDate } from "../../libs/utils";

export async function getStaticPaths() {
  const blog = await BlogAPI.get({ orders: "publishedAt" });
  return blog.map((article) => ({
    params: {
      blogId: article.id,
    },
    props: {
      data: article,
    },
  }));
}

// 記事の詳細情報を取得
const { data } = Astro.props;
---

<Layout title={data.title} og_image={data.eyecatch.url}>
  <article>
    <header>
      <div class="date">{formatDate(data.publishedAt)}</div>
      <div class="title">
        {data.title}
      </div>
      <div class="categories">
        {data.categories.map((category) => <Category data={category} />)}
      </div>
    </header>

    <hr />

    <Body html={data.body} />
  </article>
</Layout>

<style>
  article {
    display: flex;
    flex-direction: column;

    width: 100%;
    max-width: 680px;

    margin: 0 auto;
    gap: var(--space);
  }

  header {
    display: flex;
    flex-direction: column;

    gap: 16px;
  }

  .title {
    font-size: x-large;
  }

  .categories {
    display: flex;

    gap: 8px;
  }

  hr {
    border: none;
    border-bottom: var(--color-light-noir) 1px dotted;
  }
</style>
