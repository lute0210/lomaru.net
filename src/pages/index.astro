---
import Layout from "../layouts/Layout.astro";

import News from "../components/home/News.astro";
import Profile from "../components/home/Profile.astro";
import SNS from "../components/home/SNS.astro";
---

<Layout>
  <div id="main">
    <News />

    <div class="column">
      <div>
        <Profile />
      </div>
      <div>
        <SNS />
      </div>
    </div>
  </div>
</Layout>

<style>
  #main {
    flex: 1;

    display: flex;
    flex-direction: column;
    justify-content: center;

    gap: calc(var(--space) * 2);
  }

  .column {
    display: flex;
    flex-direction: column;

    gap: calc(var(--space) * 2);
  }

  @media screen and (min-width: 680px) {
    .column {
      flex-direction: row;
    }

    .column > * {
      flex: 1;

      display: flex;
    }
  }
</style>
