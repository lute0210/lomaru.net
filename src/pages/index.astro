---
import Layout from "../layouts/Layout.astro";

import Heading from "../components/index/Heading.astro";
import Profile from "../components/index/Profile.astro";
import SNS from "../components/index/SNS.astro";
---

<Layout>
  <div id="main">
    <section>
      <Heading>NEWS</Heading>
      <div>まだ何も無いよ</div>
    </section>

    <div class="column">
      <div>
    <Profile />
      </div>
      <div>
    <SNS />
      </div>
    </div>
  </div>
</Layout>

  <style>
    #main {
    display: flex;
    flex-direction: column;
    justify-content: center;

    gap: calc(var(--space) * 2);
  }

  .column {
      display: flex;
      flex-direction: column;

      gap: calc(var(--space) * 2);
    }

  @media screen and (min-width: 680px) {
    .column {
      flex-direction: row;
    }

    .column > * {
      flex: 1;

      display: flex;
    }
  }
  </style>
</Layout>
